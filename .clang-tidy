# Naming is enforced here, not in .clang-format — clang-format only lays code
# out, it has no idea what an identifier means.
#
# Requires clang-tidy 17+:  clang-tidy-20 -p build/dev <file>
#
# Three rules come from the project convention:
#   classes, functions, methods            PascalCase
#   arguments and variables                camelCase
#   global constants, static constexpr     ALL_CAPS
#
# The rest are gaps the convention does not mention, decided once here:
#   enums                EPascalCase — prefix E
#   concepts             CPascalCase — prefix C
#   type template params TPascalCase — prefix T
#   value template params camelCase  — values, not types, so no prefix
#
# The rest are gaps the convention does not mention, decided once here:
#   namespaces           lower_case  — never confusable with a type
#   enum values          PascalCase  — members of a type, not global constants,
#                                      and already qualified by the enum name
#   members              PascalCase  — private and protected keep a trailing
#                                      underscore, which is what separates a
#                                      member from a parameter of the same
#                                      name: exactly the -Wshadow class of bug
#   local constexpr      camelCase   — scoped, so not a "global constant"

# The static analyser comes along by default and is worth keeping: it caught a
# real read of a moved-from object on the first run. Listed explicitly so that
# the set of checks is visible here rather than inherited silently.
Checks: >
  readability-identifier-naming,
  clang-analyzer-*

WarningsAsErrors: 'readability-identifier-naming'

HeaderFilterRegex: '.*/(src|tests)/.*'

CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.UnionCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumPrefix
    value: E
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterPrefix
    value: T
  - key: readability-identifier-naming.TypeTemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.TypeTemplateParameterPrefix
    value: T
  # Non-type template parameters are values, not types: no T prefix, and they
  # read like the variables they stand in for.
  - key: readability-identifier-naming.ValueTemplateParameterCase
    value: camelBack
  - key: readability-identifier-naming.TemplateTemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateTemplateParameterPrefix
    value: T
  - key: readability-identifier-naming.ConceptCase
    value: CamelCase
  - key: readability-identifier-naming.ConceptPrefix
    value: C

  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.MethodCase
    value: CamelCase

  - key: readability-identifier-naming.ParameterCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.LocalVariableCase
    value: camelBack
  - key: readability-identifier-naming.LocalConstantCase
    value: camelBack
  - key: readability-identifier-naming.StaticVariableCase
    value: camelBack

  - key: readability-identifier-naming.PrivateMemberCase
    value: CamelCase
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ProtectedMemberCase
    value: CamelCase
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: _
  - key: readability-identifier-naming.PublicMemberCase
    value: CamelCase

  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalVariableCase
    value: UPPER_CASE
  - key: readability-identifier-naming.ClassConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE
# ConstexprVariableCase is deliberately unset: it would cover global constants
# and local ones alike. Without it each falls under its own rule — UPPER_CASE at
# namespace scope, camelBack for locals.
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
