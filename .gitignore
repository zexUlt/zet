# Build
build/
build-*/
out/
cmake-build-*/
compile_commands.json
CMakeUserPresets.json

# Test / coverage
.pytest_cache/
__pycache__/
*.pyc
*.gcda
*.gcno
*.profraw
coverage/

# Fuzzing artifacts (corpora are committed, findings are not)
crash-*
leak-*
timeout-*
oom-*
# A finding becomes a regression seed under its own name, which is the one
# above. Without this the file would be added, ignored and quietly missing.
!fuzz/corpus/**

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Local agent overrides
.claude/settings.local.json

# Working copies of background agents
.claude/worktrees/
