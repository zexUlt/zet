#!/usr/bin/env bash
# Refuses a commit that still carries an unresolved merge conflict.
#
# git reports conflicts once, when the merge stops. Resolving two files out of
# three and then staging everything with `git add -A` is enough to commit the
# third with its markers intact, and nothing complains until someone reads it.
#
# Only the angle brackets are matched. The `=======` line of a conflict is
# indistinguishable from a markdown heading underlined with seven equals signs,
# and a conflict never appears without `<<<<<<<` and `>>>>>>>` anyway.
set -uo pipefail

marker='^\+(<{7}|>{7})( .*)?$'

if ! git diff --cached -U0 | grep -qE "$marker"; then
    exit 0
fi

echo "Refused: the index still carries conflict markers." >&2
echo >&2
git diff --cached --name-only -G'^(<{7}|>{7})( .*)?$' \
    | sed 's/^/    /' >&2
echo >&2
echo "Resolve them, and check the other files while you are at it: git" >&2
echo "reports conflicts once, and add -A stages whatever is in the tree." >&2
exit 1
