{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(cpack:*)",
      "Bash(ninja:*)",
      "Bash(clang-format:*)",
      "Bash(clang-tidy:*)",
      "Bash(clang:*)",
      "Bash(clang++:*)",
      "Bash(g++:*)",
      "Bash(gcc:*)",
      "Bash(pytest:*)",
      "Bash(nm:*)",
      "Bash(objdump:*)",
      "Bash(readelf:*)",
      "Bash(strings:*)",
      "Bash(size:*)",
      "Bash(ldd:*)",
      "Bash(strace:*)",
      "Bash(openssl:*)",
      "Bash(pkg-config:*)",
      "Bash(getconf:*)",
      "Bash(ss:*)",
      "Bash(lsof:*)",
      "Bash(chmod:*)"
    ],
    "ask": [
      "Bash(iptables:*)",
      "Bash(systemctl:*)",
      "Bash(setcap:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)"
    ],
    "deny": [
      "Edit(./external/**)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)"
    ]
  }
}
