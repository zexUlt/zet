{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{ZET_COMPILER_LAUNCHER}"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "dev — debug build with assertions",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "displayName": "asan-ubsan — address and undefined behaviour sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "fuzz — libFuzzer targets, clang only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-omit-frame-pointer",
        "ZET_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "coverage — line coverage for the protocol core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release — what ships, and what the size gate measures",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-O2 -ffunction-sections -fdata-sections",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections -Wl,-s",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "ZET_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "musl-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-static -fuse-ld=lld",
        "CMAKE_CXX_STANDARD_LIBRARIES": "-lc++abi -lunwind"
      }
    },
    {
      "name": "musl-dev",
      "inherits": "musl-base",
      "displayName": "musl-dev — tests against the libc the binaries ship with",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "musl-asan-ubsan",
      "inherits": "musl-base",
      "displayName": "musl-asan-ubsan — sanitizers against the shipping libc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -fuse-ld=lld"
      }
    },
    {
      "name": "musl-fuzz",
      "inherits": "musl-base",
      "displayName": "musl-fuzz — libFuzzer targets against the shipping libc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -fsanitize=fuzzer-no-link,address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -fuse-ld=lld",
        "ZET_BUILD_FUZZERS": "ON",
        "ZET_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "musl-coverage",
      "inherits": "musl-base",
      "displayName": "musl-coverage — line coverage measured on the shipping libc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-static -fuse-ld=lld -fprofile-instr-generate"
      }
    },
    {
      "name": "musl-release",
      "inherits": "musl-base",
      "displayName": "musl-release — what ships, and what the size gate measures",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -O2 -ffunction-sections -fdata-sections",
        "CMAKE_EXE_LINKER_FLAGS": "-static -fuse-ld=lld -Wl,--gc-sections -Wl,-s",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "ZET_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "musl-dev",
      "configurePreset": "musl-dev"
    },
    {
      "name": "musl-asan-ubsan",
      "configurePreset": "musl-asan-ubsan"
    },
    {
      "name": "musl-fuzz",
      "configurePreset": "musl-fuzz"
    },
    {
      "name": "musl-coverage",
      "configurePreset": "musl-coverage"
    },
    {
      "name": "musl-release",
      "configurePreset": "musl-release"
    }
  ],
  "testPresets": [
    {
      "name": "common",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev",
      "inherits": "common",
      "configurePreset": "dev"
    },
    {
      "name": "asan-ubsan",
      "inherits": "common",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "coverage",
      "inherits": "common",
      "configurePreset": "coverage"
    },
    {
      "name": "musl-dev",
      "inherits": "common",
      "configurePreset": "musl-dev"
    },
    {
      "name": "musl-asan-ubsan",
      "inherits": "common",
      "configurePreset": "musl-asan-ubsan"
    },
    {
      "name": "musl-coverage",
      "inherits": "common",
      "configurePreset": "musl-coverage"
    }
  ]
}
