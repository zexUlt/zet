# zet-muxd's two sockets (docs/design.md §6). systemd binds both as root and
# passes them to the service ready; zet-muxd tells them apart by family, not
# by order. Install next to zet-muxd.service and enable the socket:
#   systemctl enable --now zet-muxd.socket

[Unit]
Description=zet mux sockets: one TCP port for every user's sessions

[Socket]
# What clients connect to: the one hole in the firewall.
ListenStream=2022
# Where each user's zet-agent registers. Every user may connect; who
# registered is told by SO_PEERCRED. The socket is zet's, as the agent
# checks; /run/zet stays root's and 0755.
ListenStream=/run/zet/mux.sock
SocketUser=zet
SocketGroup=zet
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
